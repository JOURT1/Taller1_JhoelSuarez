@model IEnumerable<Taller1_JhoelSuarez.Models.Equipo>

@{
    ViewData["Title"] = "Lista Equipos";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="FiltrarJugadoresPorEquipo" method="post">
    <label for="equipo">Selecciona un equipo:</label>
    <select id="equipo" name="idEquipo" class="form-control">
        @foreach (var equipo in Model)
        {
            <option value="@equipo.Id">@equipo.Nombre</option>
        }
    </select>
    <br />
    <button type="submit" class="btn btn-primary">Filtrar Jugadores</button>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ciudad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Títulos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AceptaExtranjeros)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estadio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ciudad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Títulos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AceptaExtranjeros)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estadio.Direccion)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

